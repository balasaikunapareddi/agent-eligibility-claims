# Copy to .env and fill in to run the demo against a real model.
# The demo uses one of these keys by default; tests and `make demo-mock` do NOT need them.
# OpenAI (make demo): get a key at https://platform.openai.com/api-keys.
#   The API is billed separately from a ChatGPT subscription.
OPENAI_API_KEY=
# Gemini free tier (make demo-gemini): get a free key at Google AI Studio,
# https://aistudio.google.com — no credit card needed.
GEMINI_API_KEY=
